{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-page",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html"]
      }
    },
    {
      "name": "app-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/*.png",
          "/*.css",
          "/*.js"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "algo-store",
      "urls": ["https://rsalgotrainerapi.gordlby.at/store/**"],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}
